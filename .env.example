# OpenAI-compatible LLM (optional — fixture/mock path works without this)
OPENAI_API_KEY=
# e.g. https://api.openai.com/v1 or a local compatible server
OPENAI_BASE_URL=
# e.g. gpt-4o-mini, gpt-4.1-mini
MODEL=

# Force the built-in fixture/heuristic path even if an API key is set
# USE_FIXTURE=true

# Force a live LLM call even for example prompts
# FORCE_LLM=true

# OpenSCAD binary (default: openscad on PATH)
# OPENSCAD_BIN=openscad

# Compile timeout in milliseconds (default 45000)
# OPENSCAD_TIMEOUT_MS=45000
