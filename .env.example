# Local AI (Ollama) — default describe → CAD path. No cloud key required.
# Shares the default Ollama server at 127.0.0.1:11434 with other apps on this
# machine (including Agent Smith). Isolation is by model name: DescribePrint
# uses its own dedicated model. Leave Smith models and Ollama’s port/config
# untouched. Do not delete or replace existing models.
#
# OPENAI_API_KEY can be any non-empty string; Ollama does not validate it.
OPENAI_BASE_URL=http://127.0.0.1:11434/v1
OPENAI_API_KEY=ollama
# DescribePrint’s dedicated model (default qwen2.5-coder:32b — smartest local
# quality on capable ~32GB machines; higher RAM than 14b/7b). Never set this
# to smith-minicpm5 or openbmb/minicpm5-* — those belong to Agent Smith.
MODEL=qwen2.5-coder:32b
# Lighter overrides if 32b is too heavy for this machine (same dedicated family):
# MODEL=qwen2.5-coder:14b
# MODEL=qwen2.5-coder:7b

# Optional two-pass: Pass A plans features/dims as short JSON, Pass B writes
# OpenSCAD from that plan. Default on. Set 0 to use a single stronger prompt.
SMART_PIPELINE=1
# Optional planning-model override (defaults to the same MODEL):
# PLAN_MODEL=qwen2.5-coder:32b

# Optional cloud override (OpenAI or any compatible host):
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_API_KEY=sk-...
# MODEL=gpt-4o-mini

# Force the built-in fixture/heuristic path even when local AI is configured
# USE_FIXTURE=true

# Force a live LLM call (skips fixtures unless USE_FIXTURE is also set)
# FORCE_LLM=true

# OpenSCAD binary (default: openscad on PATH)
# OPENSCAD_BIN=openscad

# Compile timeout in milliseconds (default 45000)
# OPENSCAD_TIMEOUT_MS=45000

# Local completion timeout in milliseconds (default 180000; 32b can be slow)
# LLM_TIMEOUT_MS=180000
